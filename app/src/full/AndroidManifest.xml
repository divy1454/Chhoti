<?xml version="1.0" encoding="utf-8"?>
<!-- Full edition only: reading chat notifications. Play Protect's fraud protection (India and
     some other countries) blocks sideloaded apps that declare this, so the lite edition omits it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name=".MessageListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
